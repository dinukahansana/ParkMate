<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_parking_card">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvRowStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:padding="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Paid" />

        <TextView
            android:id="@+id/tvRowVehicleNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/tvRowStatus"
            android:layout_marginEnd="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#10213A"
            tools:text="ABC-1234" />

    </RelativeLayout>

    <TextView
        android:id="@+id/tvRowSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:textColor="#5C687A"
        tools:text="Car • 3 hours" />

    <TextView
        android:id="@+id/tvRowFee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#10213A"
        tools:text="Rs. 300.00" />

    <Button
        android:id="@+id/btnViewDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/action_view_details"
        android:textAllCaps="false"
        android:textColor="#1565C0"
        android:backgroundTint="#E8F0FE" />

</LinearLayout>