<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F8FC"
    android:theme="@style/Theme.Material3.Light.NoActionBar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/details_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#10213A" />

        <TextView
            android:id="@+id/tvDetailVehicleNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#10213A"
            tools:text="ABC-1234" />

        <TextView
            android:id="@+id/tvDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:padding="10dp"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Paid" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_parking_card">

            <TextView
                android:id="@+id/tvDetailRecordId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                tools:text="Record ID: PM-001" />

            <TextView
                android:id="@+id/tvDetailVehicleType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="17sp"
                tools:text="Vehicle type: Car" />

            <TextView
                android:id="@+id/tvDetailHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="17sp"
                tools:text="Parking duration: 3 hours" />

            <TextView
                android:id="@+id/tvDetailRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="17sp"
                tools:text="Hourly rate: Rs. 100.00" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/form_fee_label"
                android:textSize="17sp"
                android:textColor="#5C687A" />

            <TextView
                android:id="@+id/tvDetailFee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                tools:text="Rs. 300.00" />

        </LinearLayout>

        <Button
            android:id="@+id/btnEditRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="56dp"
            android:text="@string/action_edit_record"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0" />

        <Button
            android:id="@+id/btnDeleteRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="56dp"
            android:text="@string/action_delete_record"
            android:textAllCaps="false"
            android:textColor="#B42318"
            android:backgroundTint="#FDE8E8" />

        <Button
            android:id="@+id/btnBackRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/action_back_records"
            android:textAllCaps="false"
            android:textColor="#1565C0"
            android:backgroundTint="#E8F0FE" />

    </LinearLayout>

</ScrollView>